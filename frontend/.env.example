# MediTwin frontend — copy to .env if you need to change anything.
# All of these have working defaults; the file exists to show what is configurable.

# Where the API lives. Left empty, the app uses relative URLs and Vite's dev proxy
# forwards them — which is what you want locally, because every request stays
# same-origin and CORS never enters the picture.
#
# Set this only when the frontend is served from a different host than the API,
# e.g. a static build on Netlify talking to an API elsewhere.
VITE_API_URL=http://localhost:5000/api/v1
# Socket.IO endpoint. Same reasoning: empty means same-origin through the proxy.
VITE_SOCKET_URL=

# Where the dev proxy forwards /api and /socket.io. Change this if the backend
# runs on a port other than 5000.
VITE_PROXY_TARGET=http://127.0.0.1:5000

# Shows the "Demo Mode" entry in the sidebar, which walks a robot through a full
# collection run for a presentation. Turn it off for anything resembling a real
# deployment — it dispatches actual robots.
VITE_ENABLE_DEMO=true
